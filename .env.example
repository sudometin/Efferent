# --- required -------------------------------------------------------------
# From @BotFather → /newbot
BOT_TOKEN=123456789:AAH-your-token-here

# Your Telegram numeric user id. Start the bot and send /id to see it.
OWNER_ID=0

# --- optional -------------------------------------------------------------
# Comma-separated user ids allowed to use the bot. Empty = anyone.
ALLOWED_USERS=

# Honeypot (owner-only console). Set HONEYPOT_ENABLED=0 to switch it off.
HONEYPOT_ENABLED=1
HONEYPOT_PORT=2222

# Hour (UTC) for the daily "Script Kiddie of the Day" report.
KIDDIE_HOUR_UTC=18

# drand overrides (leave empty for tle defaults: api.drand.sh / quicknet)
DRAND_NETWORK=
DRAND_CHAIN=

# ── Ops: SSH manager Mini App ─────────────────────────────
OPS_ENABLED=1
WEBAPP_URL=                     # PUBLIC https URL of the Mini App, e.g. https://ops.example.com (Telegram requires HTTPS)
WEBAPP_PORT=8088                # local port the gateway listens on (put HTTPS in front of it)
OPS_USERS=                      # extra operator user ids (comma-separated); the owner always is one
OPS_CA_PASSPHRASE=              # encrypts the CA private key on disk (recommended)
OPS_HEALTH_MIN=5                # health ping interval, minutes (also feeds GPU afferent + reflex arcs)
OPS_JOB_POLL=60                 # how often /fx_watch jobs are checked, seconds
HP_STREAM_CHAT=                 # channel/chat id for the live honeypot feed (/hp_stream on), e.g. @unfinitum or -100…

# ── network (only if Telegram is slow/blocked on your connection) ──
# PROXY_URL=socks5://127.0.0.1:10808    # your VPN app's local proxy (v2rayN 10808 · Hiddify 12334 · Clash http://127.0.0.1:7890)
